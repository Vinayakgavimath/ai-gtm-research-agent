        "jsCode": "const content = $input.item.json.choices[0].message.content;\ntry {\n  const cleaned = content\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, ' ')\n    .trim();\n  \n  const parsed = JSON.parse(cleaned);\n  \n  return {\n    json: {\n      company: parsed.company_name || \"Unknown\",\n      what: parsed.what || \"\",\n      who: parsed.who || \"\",\n      pain_point: parsed.pain_point || \"\",\n      trigger_event: parsed.trigger_event || \"\",\n      outreach_angle: parsed.outreach_angle || \"\"\n    }\n  };\n} catch(e) {\n  return {\n    json: {\n      company: \"Parse Error\",\n      what: content,\n      who: \"\",\n      pain_point: \"\",\n      trigger_event: \"\",\n      outreach_angle: \"\"\n    }\n  };\n}"
